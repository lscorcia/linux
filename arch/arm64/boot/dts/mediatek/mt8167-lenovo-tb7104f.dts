// SPDX-License-Identifier: GPL-2.0
/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/leds/common.h>
#include "mt8167.dtsi"
#include "mt6392.dtsi"

/ {
	model = "Lenovo Tab E7";
	chassis-type = "tablet";
	compatible = "lenovo,tb7104f", "mediatek,mt8167";

	aliases {
		mmc0 = &mmc0;
		mmc1 = &mmc1;
		serial0 = &uart0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		bootargs = "console=tty0 console=ttyS0,921600n1 earlycon=uart8250,mmio32,0x11005000";
		ranges;

		stdout-path = &framebuffer0;

		framebuffer0: framebuffer@7f020000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x7f020000 0x0 (1024 * 600 * 4)>;
			width = <1024>;
			height = <600>;
			stride = <(1024 * 4)>;
			format = "a8r8g8b8";
			display = <&dsi>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x40000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* Carve-out di esempio da 1MB (0x100000 bytes) */
		ramoops@42ff0000 {
			compatible = "ramoops";
			reg = <0x0 0x42ff0000 0x0 0x00100000>; /* Indirizzo a 64-bit e dimensione */
			record-size = <0x00020000>;  /* 128KB per ogni log di panic/oops */
			console-size = <0x00020000>; /* 128KB per i log della console */
			ftrace-size = <0x00020000>;  /* 128KB per i log ftrace */
			pmsg-size = <0x00020000>;    /* 128KB per i messaggi utente */
			ecc = <1>;                   /* Opzionale: abilita la protezione software ECC */
			no-map;                      /* EVITA che il kernel mappi questa RAM linearmente */
		};

		atf-reserved-memory {
			no-map;
			reg = <0x00 0x54600000 0x0 0x30000>;
		};

		ram_console-reserved-memory {
			compatible = "mediatek,ram_console";
			reg = <0x0 0x54400000 0x0 0x10000>;
		};

		pstore-reserved-memory {
			compatible = "mediatek,pstore";
			reg = <0x0 0x54410000 0x0 0xe0000>;
		};

		minirdump-reserved-memory {
			compatible = "mediatek,minirdump";
			reg = <0x0 0x544f0000 0x0 0x10000>;
		};

		consys-reserve-memory {
			compatible = "mediatek,consys-reserve-memory";
			no-map;
			size = <0x0 0x200000>;
			alignment = <0x0 0x200000>;
		};
	};

	vbat: regulator-vbat-sys {
		compatible = "regulator-fixed";
		regulator-name = "vbat";
		regulator-always-on;
		regulator-boot-on;
	};

	backlight_lcd: backlight-lcd {
		compatible = "pwm-backlight";
		brightness-levels = <
			  0  16  32  48  64  80  96 112
			128 144 160 176 192 208 224 240
			255
		>;
		default-brightness-level = <9>;
		enable-gpios = <&pio 43 GPIO_ACTIVE_HIGH>;
		power-supply = <&mt6392_vio18_reg>;
		pwms = <&disp_pwm 0 1000000>;
	};

	usb_vbus: regulator {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pio 68 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	leds {
		compatible = "gpio-leds";

		led_red: led-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_CHARGING;
			gpios = <&pio 56 GPIO_ACTIVE_HIGH>;
			default-state = "off";
			retain-state-suspended;

			pinctrl-names = "default";
			pinctrl-0 = <&led_pins>;
		};
	};
};

/* With the firmware on Android devices, cores don't seem to come back after out
   idle/unplug (though initial SMP boot is fine) */
&cpu0 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6392_vproc_reg>;
};

&cpu1 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6392_vproc_reg>;
};

&cpu2 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6392_vproc_reg>;
};

&cpu3 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6392_vproc_reg>;
};

&mmsys { status = "disabled"; };
&ovl0 { status = "disabled"; };
&rdma0 { status = "disabled"; };
&wdma {	status = "disabled"; };
&ccorr { status = "disabled"; };
&aal { status = "disabled"; };
&gamma { status = "disabled"; };
&dither { status = "disabled"; };

&disp_pwm {
	//status = "okay";
};

&mipi_tx {
	//status = "okay";
};

&dsi {
	panel: panel@0 {
		compatible = "lenovo,tb7104f-panel";
		reg = <0>;
		backlight = <&backlight_lcd>;
		enable-gpios = <&pio 50 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pio 66 GPIO_ACTIVE_LOW>;
		vdd-supply = <&mt6392_vgp2_reg>;

		pinctrl-names = "default";
		pinctrl-0 = <&panel_pins>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

&rdma0_out {
	remote-endpoint = <&dsi_in>;
};

&dsi_in {
	remote-endpoint = <&rdma0_out>;
};

&dsi_out {
	remote-endpoint = <&panel_in>;
};

&i2c0 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&i2c_pins_0>;
	clock-div = <2>;

	// TODO: touch gsl3670 @ 0x40
};

&i2c1 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&i2c_pins_1>;
	clock-div = <2>;

	// TODO: orientation sensor gsl3670 @ 0x40 or bma253 @ 0x18
};

&i2c2 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&i2c_pins_2>;
	clock-div = <2>;

	// TODO: camera main @ 0x36, camera sub @ 0x30
};

&mmc0 {
	status = "okay";

	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;

	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	cap-mmc-hw-reset;
	non-removable;

	vmmc-supply = <&mt6392_vemc3v3_reg>;
	vqmmc-supply = <&mt6392_vio18_reg>;
};

// ---- microSD (mmc1) ----
&mmc1 {
	status = "okay";

	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;

	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	sd-uhs-sdr104;

	cd-gpios = <&pio 20 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&mt6392_vmch_reg>;
	vqmmc-supply = <&mt6392_vmc_reg>;
};

&pio {
	i2c_pins_0: i2c0-pins {
		pins_i2c {
			bias-disable;
			pinmux = <MT8167_PIN_58_SDA0__FUNC_SDA0_0>,
				 <MT8167_PIN_59_SCL0__FUNC_SCL0_0>;
		};
	};

	i2c_pins_1: i2c1-pins {
		pins_i2c {
			bias-disable;
			pinmux = <MT8167_PIN_52_SDA1__FUNC_SDA1_0>,
				 <MT8167_PIN_53_SCL1__FUNC_SCL1_0>;
		};
	};

	i2c_pins_2: i2c2-pins {
		pins_i2c {
			bias-disable;
			pinmux = <MT8167_PIN_60_SDA2__FUNC_SDA2_0>,
				 <MT8167_PIN_61_SCL2__FUNC_SCL2_0>;
		};
	};

	keypad_pins: keypad-pins {
		pins_cols {
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
			input-enable;
			pinmux = <MT8167_PIN_42_KPCOL0__FUNC_KPCOL0>;
		};
	};

	mmc0_pins_default: mmc0-default-pins {
		pins_cmd_dat {
			pinmux = <MT8167_PIN_120_MSDC0_DAT0__FUNC_MSDC0_DAT0>,
				 <MT8167_PIN_119_MSDC0_DAT1__FUNC_MSDC0_DAT1>,
				 <MT8167_PIN_118_MSDC0_DAT2__FUNC_MSDC0_DAT2>,
				 <MT8167_PIN_117_MSDC0_DAT3__FUNC_MSDC0_DAT3>,
				 <MT8167_PIN_113_MSDC0_DAT4__FUNC_MSDC0_DAT4>,
				 <MT8167_PIN_112_MSDC0_DAT5__FUNC_MSDC0_DAT5>,
				 <MT8167_PIN_111_MSDC0_DAT6__FUNC_MSDC0_DAT6>,
				 <MT8167_PIN_110_MSDC0_DAT7__FUNC_MSDC0_DAT7>,
				 <MT8167_PIN_115_MSDC0_CMD__FUNC_MSDC0_CMD>;
			input-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins_clk {
			pinmux = <MT8167_PIN_116_MSDC0_CLK__FUNC_MSDC0_CLK>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins_rst {
			pinmux = <MT8167_PIN_114_MSDC0_RSTB__FUNC_MSDC0_RSTB>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc0_pins_uhs: mmc0-uhs-pins {
		pins_cmd_dat {
			pinmux = <MT8167_PIN_120_MSDC0_DAT0__FUNC_MSDC0_DAT0>,
				 <MT8167_PIN_119_MSDC0_DAT1__FUNC_MSDC0_DAT1>,
				 <MT8167_PIN_118_MSDC0_DAT2__FUNC_MSDC0_DAT2>,
				 <MT8167_PIN_117_MSDC0_DAT3__FUNC_MSDC0_DAT3>,
				 <MT8167_PIN_113_MSDC0_DAT4__FUNC_MSDC0_DAT4>,
				 <MT8167_PIN_112_MSDC0_DAT5__FUNC_MSDC0_DAT5>,
				 <MT8167_PIN_111_MSDC0_DAT6__FUNC_MSDC0_DAT6>,
				 <MT8167_PIN_110_MSDC0_DAT7__FUNC_MSDC0_DAT7>,
				 <MT8167_PIN_115_MSDC0_CMD__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins_clk {
			pinmux = <MT8167_PIN_116_MSDC0_CLK__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins_rst {
			pinmux = <MT8167_PIN_114_MSDC0_RSTB__FUNC_MSDC0_RSTB>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc1_pins_default: mmc1-default-pins {
		pins_cmd_dat {
			pinmux = <MT8167_PIN_106_MSDC1_DAT0__FUNC_MSDC1_DAT0>,
				 <MT8167_PIN_107_MSDC1_DAT1__FUNC_MSDC1_DAT1>,
				 <MT8167_PIN_108_MSDC1_DAT2__FUNC_MSDC1_DAT2>,
				 <MT8167_PIN_109_MSDC1_DAT3__FUNC_MSDC1_DAT3>,
				 <MT8167_PIN_104_MSDC1_CMD__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins_clk {
			pinmux = <MT8167_PIN_105_MSDC1_CLK__FUNC_MSDC1_CLK>;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins_insert {
			pinmux = <MT8167_PIN_20_EINT20__FUNC_GPIO20>;
			bias-pull-up;
		};
	};

	mmc1_pins_uhs: mmc1-uhs-pins {
		pins_cmd_dat {
			pinmux = <MT8167_PIN_106_MSDC1_DAT0__FUNC_MSDC1_DAT0>,
				 <MT8167_PIN_107_MSDC1_DAT1__FUNC_MSDC1_DAT1>,
				 <MT8167_PIN_108_MSDC1_DAT2__FUNC_MSDC1_DAT2>,
				 <MT8167_PIN_109_MSDC1_DAT3__FUNC_MSDC1_DAT3>,
				 <MT8167_PIN_104_MSDC1_CMD__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins_clk {
			pinmux = <MT8167_PIN_105_MSDC1_CLK__FUNC_MSDC1_CLK>;
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};
	};

	usb0_pins: usb0-pins {
		pins_iddig {
			pinmux = <MT8167_PIN_41_KPROW1__FUNC_IDDIG>;
			slew-rate = <0>;
			bias-disable;
		};
		pins_vbus {
			pinmux = <MT8167_PIN_68_MSDC2_CMD__FUNC_GPIO68>;
			output-low;
		};
	};

	uart0_pins: uart0-pins {
		pins_rx {
			pinmux = <MT8167_PIN_62_URXD0__FUNC_URXD0>;
			input-enable;
			bias-pull-up;
		};
		pins_tx {
			pinmux = <MT8167_PIN_63_UTXD0__FUNC_UTXD0>;
		};
	};

	panel_pins: dsi0-pins {
		pins_rst {
			pinmux = <MT8167_PIN_66_LCM_RST__FUNC_GPIO66>;
			bias-pull-up;
		};
	};

	led_pins: led-pins {
		pins_cmd_dat {
			pinmux = <MT8167_PIN_56_I2S_LRCK__FUNC_GPIO56>;
			slew-rate = <1>;
		};
	};
};

&keypad {
	status = "okay";
	debounce-delay-ms = <32>;

	pinctrl-names = "default";
	pinctrl-0 = <&keypad_pins>;

	keypad,num-rows = <1>;
	keypad,num-columns = <1>;
	linux,keymap = <MATRIX_KEY(0x00, 0x00, KEY_VOLUMEUP)>;
	mediatek,keys-per-group = <1>;
};

&pmic {
	interrupt-parent = <&pio>;
	interrupts = <28 IRQ_TYPE_LEVEL_HIGH>;
};

&uart0 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
};

&usb0 {
	status = "okay";
	dr_mode = "peripheral";
	usb-role-switch;

	pinctrl-names = "default";
	pinctrl-0 = <&usb0_pins>;

	//vusb33-supply = <&mt6392_vusb_reg>;

	usb_con: connector {
		compatible = "gpio-usb-b-connector", "usb-b-connector";
		type = "micro";
		id-gpios = <&pio 41 GPIO_OPEN_SOURCE>;
		vbus-supply = <&mt6392_vusb_reg>;
	};
};

&usb_phy {
	status = "okay";
};

&btcvsd_snd {
	status = "okay";
};

&mt6392_audio_codec {
	status = "okay";
};

&mt6392regulators {
	vproc-supply = <&vbat>;
	vcore-supply = <&vbat>;
	vsys-supply = <&vbat>;
	ldo1-supply = <&vbat>;
	ldo2-supply = <&vbat>;
	ldo3-supply = <&vbat>;
};

&mt6392_vcore_reg {
	regulator-min-microvolt = <700000>;
	regulator-max-microvolt = <1350000>;
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vproc_reg {
	regulator-min-microvolt = <700000>;
	regulator-max-microvolt = <1350000>;
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vsys_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vaud28_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vxo22_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vaud22_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vadc18_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vcama_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vusb_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vmc_reg {
	regulator-boot-on;
};

&mt6392_vmch_reg {
	regulator-boot-on;
};

&mt6392_vemc3v3_reg {
	regulator-boot-on;
};

&mt6392_vm25_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vdig18_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vm_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vio18_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vrtc_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vgp2_reg {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};