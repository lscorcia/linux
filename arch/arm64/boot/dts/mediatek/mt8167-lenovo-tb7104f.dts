/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include "mt8167.dtsi"
#include "mt6392.dtsi"

/ {
	model = "Lenovo Tab E7";
	chassis-type = "embedded";
	compatible = "lenovo,tb7104f", "mediatek,mt8167";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		bootargs = "console=tty0 console=ttyS0,921600n1 earlycon=uart8250,mmio32,0x11005000 fbcon=rotate:1";
		ranges;

		stdout-path = &framebuffer0;

		framebuffer0: framebuffer@7f1c0000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x7f1c0000 0x0 (1024 * 600 * 3)>;
			width = <1024>;
			height = <600>;
			stride = <(1024 * 3)>;
			format = "r8g8b8";
			display = <&dpi0>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x40000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		atf-reserved-memory {
			reg = <0x00 0x54600000 0x00 0x30000>;
			no-map;
		};

		consys-reserve-memory {
			size = <0x00 0x200000>;
			alignment = <0x00 0x200000>;
			no-map;
		};
	};

	firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		key-volume-up {
			gpios = <&pio 42 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			label = "volume_up";
			debounce-interval = <15>;
		};
		key-volume-down {
			gpios = <&pio 43 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
			label = "volume_down";
			debounce-interval = <15>;
		};
	};

	vbat: regulator-vbat-sys {
		compatible = "regulator-fixed";
		regulator-name = "vbat";
		regulator-always-on;
		regulator-boot-on;
	};

	backlight_lcd: backlight-lcd {
		compatible = "pwm-backlight";
		brightness-levels = <
			  0  16  32  48  64  80  96 112
			128 144 160 176 192 208 224 240
			255
		>;
		default-brightness-level = <9>;
		power-supply = <&mt6392_vmch_reg>;
		pwms = <&disp_pwm 0 1000000>;
	};

	mt8167_audio_codec: mt8167_audio_codec {
		compatible = "mediatek,mt8167-codec";
		clocks = <&topckgen CLK_TOP_AUDIO>;
		clock-names = "bus";
		mediatek,afe-regmap = <&afe>;
		mediatek,apmixedsys-regmap = <&apmixedsys>;
		mediatek,dmic-wire-mode = <1>; /* 0(ONE_WIRE) 1(TWO_WIRE) */
		mediatek,headphone-cap-sel = <1>; /* 0(10UF) 1(22UF) 2(33UF) 3(47UF) */
	};
/*
	sound {
		compatible = "mediatek,mt8167s-es7243";
		mediatek,platform = <&afe>;
		pinctrl-0 = <&aud_default_pins>;
		pinctrl-1 = <&aud_extamp_on_pins>;
		pinctrl-2 = <&aud_extamp_off_pins>;
		pinctrl-names = "default", "extamp_on", "extamp_off";
		tdmadc-3p3v-supply = <&mt6392_vmch_reg>;
		tdmadc-1p8v-supply = <&mt6392_vcamio_reg>;
	};
*/
	gpio-keys {
		compatible = "gpio-keys";

		volume-up-button {
			label = "volume up";
			gpios = <&pio 42 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};

		volume-down-button {
			label = "volume down";
			gpios = <&pio 40 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};

		mic-mute-switch {
			label = "mic mute";
			gpios = <&pio 21 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_MICMUTE>;
		};
	};
};

/* With the firmware on Android devices, cores don't seem to come back after out
   idle/unplug (though initial SMP boot is fine) */

&cpu0 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6392_vproc_reg>;
};

&cpu1 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6392_vproc_reg>;
};

&cpu2 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6392_vproc_reg>;
};

&cpu3 {
	/delete-property/ cpu-idle-states;
	proc-supply = <&mt6392_vproc_reg>;
};

/*
&cluster0_opp {
	opp-1500000000 {
		opp-hz = /bits/ 64 <1500000000>;
		opp-microvolt = <1300000>;
	};
};
*/
&disp_pwm {
	status = "okay";
};

&mipi_tx {
	status = "okay";
};

&dpi0 {
	status = "okay";

	panel: panel@0 {
		reg = <0>;
		compatible = "kd,kd070d5450nha6", "panel-dpi";
		label = "display";
		power-supply = <&mt6392_vgp2_reg>;
		backlight = <&backlight_lcd>;
		reset-gpios = <&pio 101 GPIO_ACTIVE_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&panel_pins>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dpi0_out>;
			};
		};

		panel-timing {
			hactive = <1024>;
			vactive = <600>;

			hback-porch = <112>;
			hfront-porch = <160>;
			hsync-len = <48>;

			vback-porch = <13>;
			vfront-porch = <12>;
			vsync-len = <10>;

			clock-frequency = <((1024 + 112 + 160 + 48) * (600 + 13 + 12 + 10) * 60 / 1000)>;

			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <1>;
		};
	};
};

&rdma0_out {
	remote-endpoint = <&dpi0_in>;
};

&dpi0_in {
	remote-endpoint = <&rdma0_out>;
};

&dpi0_out {
	remote-endpoint = <&panel_in>;
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c_pins_0>;
	clock-div = <1>;
	status = "okay";
	clock-frequency = <400000>;

	/* ---- Touchscreen: Goodix GT911 on i2c0 ---- */
	touchscreen@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		interrupt-parent = <&pio>;
		interrupts = <100 IRQ_TYPE_EDGE_FALLING>;
		irq-gpios = <&pio 100 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pio 101 GPIO_ACTIVE_HIGH>;
		AVDD28-supply = <&mt6392_vgp1_reg>;
		VDDIO-supply = <&mt6392_vio18_reg>;
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c_pins_1>;
	status = "okay";
	clock-div = <1>;
	clock-frequency = <400000>;

};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c_pins_2>;
	status = "okay";
};

&mmc0 {
	status = "okay";

	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;

	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	cap-mmc-hw-reset;
	non-removable;

	vmmc-supply = <&mt6392_vemc3v3_reg>;
	vqmmc-supply = <&mt6392_vio18_reg>;
};

/* ---- microSD (mmc1) ---- */
&mmc1 {
	status = "okay";
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	vmmc-supply = <&mt6392_vmch_reg>;
	vqmmc-supply = <&mt6392_vmc_reg>;
	cd-gpios = <&pio 20 GPIO_ACTIVE_LOW>;
	disable-wp;
	no-mmc;
	no-sdio;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;
};

&pio {
	alsps_intpin_default: alsps-default-pins {
		pins {
			bias-disable;
			input-enable;
			slew-rate = <0>;
			pinmux = <MT8167_PIN_5_EINT5__FUNC_GPIO5>;
		};
	};

	mc3416_intpin_default: mc3416-default-pins {
		pins {
			pinmux = <MT8167_PIN_12_EINT12__FUNC_GPIO12>;
		};
	};

	i2c_pins_0: i2c0-pins {
		pins_i2c {
			bias-disable;
			pinmux = <MT8167_PIN_58_SDA0__FUNC_SDA0_0>,
				 <MT8167_PIN_59_SCL0__FUNC_SCL0_0>;
		};
	};

	i2c_pins_1: i2c1-pins {
		pins_i2c {
			bias-disable;
			pinmux = <MT8167_PIN_52_SDA1__FUNC_SDA1_0>,
				 <MT8167_PIN_53_SCL1__FUNC_SCL1_0>;
		};
	};

	i2c_pins_2: i2c2-pins {
		pins_i2c {
			bias-disable;
			pinmux = <MT8167_PIN_60_SDA2__FUNC_SDA2_0>,
				 <MT8167_PIN_61_SCL2__FUNC_SCL2_0>;
		};
	};
	
	mmc0_pins_default: mmc0-default-pins {
		pins_cmd_dat {
			pinmux = <MT8167_PIN_120_MSDC0_DAT0__FUNC_MSDC0_DAT0>,
				 <MT8167_PIN_119_MSDC0_DAT1__FUNC_MSDC0_DAT1>,
				 <MT8167_PIN_118_MSDC0_DAT2__FUNC_MSDC0_DAT2>,
				 <MT8167_PIN_117_MSDC0_DAT3__FUNC_MSDC0_DAT3>,
				 <MT8167_PIN_113_MSDC0_DAT4__FUNC_MSDC0_DAT4>,
				 <MT8167_PIN_112_MSDC0_DAT5__FUNC_MSDC0_DAT5>,
				 <MT8167_PIN_111_MSDC0_DAT6__FUNC_MSDC0_DAT6>,
				 <MT8167_PIN_110_MSDC0_DAT7__FUNC_MSDC0_DAT7>,
				 <MT8167_PIN_115_MSDC0_CMD__FUNC_MSDC0_CMD>;
			input-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins_clk {
			pinmux = <MT8167_PIN_116_MSDC0_CLK__FUNC_MSDC0_CLK>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins_rst {
			pinmux = <MT8167_PIN_114_MSDC0_RSTB__FUNC_MSDC0_RSTB>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc0_pins_uhs: mmc0-uhs-pins {
		pins_cmd_dat {
			pinmux = <MT8167_PIN_120_MSDC0_DAT0__FUNC_MSDC0_DAT0>,
				 <MT8167_PIN_119_MSDC0_DAT1__FUNC_MSDC0_DAT1>,
				 <MT8167_PIN_118_MSDC0_DAT2__FUNC_MSDC0_DAT2>,
				 <MT8167_PIN_117_MSDC0_DAT3__FUNC_MSDC0_DAT3>,
				 <MT8167_PIN_113_MSDC0_DAT4__FUNC_MSDC0_DAT4>,
				 <MT8167_PIN_112_MSDC0_DAT5__FUNC_MSDC0_DAT5>,
				 <MT8167_PIN_111_MSDC0_DAT6__FUNC_MSDC0_DAT6>,
				 <MT8167_PIN_110_MSDC0_DAT7__FUNC_MSDC0_DAT7>,
				 <MT8167_PIN_115_MSDC0_CMD__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins_clk {
			pinmux = <MT8167_PIN_116_MSDC0_CLK__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins_rst {
			pinmux = <MT8167_PIN_114_MSDC0_RSTB__FUNC_MSDC0_RSTB>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc1_pins_default: mmc1-default {
		pins_cmd_dat {
			pinmux = <MT8167_PIN_106_MSDC1_DAT0__FUNC_MSDC1_DAT0>,
				 <MT8167_PIN_107_MSDC1_DAT1__FUNC_MSDC1_DAT1>,
				 <MT8167_PIN_108_MSDC1_DAT2__FUNC_MSDC1_DAT2>,
				 <MT8167_PIN_109_MSDC1_DAT3__FUNC_MSDC1_DAT3>,
				 <MT8167_PIN_104_MSDC1_CMD__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
		pins_clk {
			pinmux = <MT8167_PIN_105_MSDC1_CLK__FUNC_MSDC1_CLK>;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};
		pins_insert {
			pinmux = <MT8167_PIN_20_EINT20__FUNC_GPIO20>;
			bias-pull-up;
		};
	};

	mmc1_pins_uhs: mmc1-uhs {
		pins_cmd_dat {
			pinmux = <MT8167_PIN_106_MSDC1_DAT0__FUNC_MSDC1_DAT0>,
				 <MT8167_PIN_107_MSDC1_DAT1__FUNC_MSDC1_DAT1>,
				 <MT8167_PIN_108_MSDC1_DAT2__FUNC_MSDC1_DAT2>,
				 <MT8167_PIN_109_MSDC1_DAT3__FUNC_MSDC1_DAT3>,
				 <MT8167_PIN_104_MSDC1_CMD__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
		pins_clk {
			pinmux = <MT8167_PIN_105_MSDC1_CLK__FUNC_MSDC1_CLK>;
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};
	};
/*
	drvvbus_default: drvvbus-default-pins {
		pins_cmd_dat {
			pinmux = <MT8167_PIN_6_EINT6__FUNC_GPIO6>;
			output-low;
		};
	};

	usb_switch_default: usb-switch-pins {
		pins_cmd_dat {
			pinmux = <MT8167_PIN_12_EINT12__FUNC_PWM_A>;
			output-low;
		};
	};
*/
	usb0_iddig: iddig-pins {
		pins_cmd_dat {
			pinmux = <MT8167_PIN_19_EINT19__FUNC_IDDIG>;
			slew-rate = <0>;
			bias-disable;
		};
	};

	panel_pins: panel-pins {
		pins_rst {

		};
	};

	uart0_pins: uart0-pins {
		pins_rx {
			pinmux = <MT8167_PIN_62_URXD0__FUNC_URXD0>;
			input-enable;
			bias-pull-up;
		};
		pins_tx {
			pinmux = <MT8167_PIN_63_UTXD0__FUNC_UTXD0>;
		};
	};

	aud_extamp_off_pins: audexampoff-pins {
		pins_extamp {
			/*output-low;
			slew-rate = <1>;
			pinmux = <MT8167_PIN_51_SPI_MO__FUNC_GPIO51>;*/
		};
	};
/*
	aud_extamp_on_pins: audexampon-pins {
		pins_extamp {
			output-high;
			slew-rate = <1>;
			pinmux = <MT8167_PIN_51_SPI_MO__FUNC_GPIO51>;
		};
	};

	aud_default_pins: audiodefault-pins {
		pins_extamp {
			output-low;
			slew-rate = <1>;
			pinmux = <MT8167_PIN_51_SPI_MO__FUNC_GPIO51>;
		};

		pins_cmd_dat {
			drive-strength = <MTK_DRIVE_4mA>;
			pinmux = <MT8167_PIN_71_MSDC2_DAT1__FUNC_I2S_8CH_DO1
				  MT8167_PIN_72_MSDC2_DAT2__FUNC_I2S_8CH_LRCK
				  MT8167_PIN_73_MSDC2_DAT3__FUNC_I2S_8CH_BCK
				  MT8167_PIN_38_MRG_DI__FUNC_I2S0_DI>;
		};
	};*/
};

&pmic {
	interrupt-parent = <&pio>;
	interrupts = <28 IRQ_TYPE_LEVEL_HIGH>;
};

&uart0 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
};

&usb0 {
	status = "okay";
	dr_mode = "peripheral";
	usb-role-switch;

	pinctrl-names = "default";
	pinctrl-0 = <&usb0_iddig>;

	//vusb33-supply = <&mt6392_vusb_reg>;

	usb_con: connector {
		compatible = "gpio-usb-b-connector", "usb-b-connector";
		type = "micro";
		id-gpios = <&pio 19 GPIO_OPEN_SOURCE>;
		vbus-supply = <&mt6392_vusb_reg>;
	};
};

&usb_phy {
	status = "okay";
};

&mt6392regulators {
	vproc-supply = <&vbat>;
	vcore-supply = <&vbat>;
	vsys-supply = <&vbat>;
	ldo1-supply = <&vbat>;
	ldo2-supply = <&vbat>;
	ldo3-supply = <&vbat>;
};

&mt6392_vcore_reg {
	regulator-min-microvolt = <700000>;
	regulator-max-microvolt = <1350000>;
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vproc_reg {
	regulator-min-microvolt = <700000>;
	regulator-max-microvolt = <1350000>;
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vsys_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vaud28_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vxo22_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vaud22_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vadc18_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vcama_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vusb_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vmc_reg {
	regulator-boot-on;
};

&mt6392_vmch_reg {
	regulator-boot-on;
};

&mt6392_vemc3v3_reg {
	regulator-boot-on;
};

&mt6392_vm25_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vdig18_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vm_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vio18_reg {
	regulator-always-on;
	regulator-boot-on;
};

&mt6392_vrtc_reg {
	regulator-always-on;
	regulator-boot-on;
};
